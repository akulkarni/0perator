{
  "name": "0perator",
  "version": "0.3.0",
  "description": "Build full-stack applications instantly through natural conversation",
  "author": "Tiger Data",
  "type": "module",
  "bin": {
    "0perator": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "skills.yaml",
    "templates"
  ],
  "scripts": {
    "build": "tsc && shx chmod +x dist/*.js",
    "watch": "tsc --watch",
    "prepare": "npm run build",
    "preuninstall": "node dist/scripts/cleanup.js",
    "dev": "./bun src/index.ts",
    "dev:mcp": "./bun src/index.ts mcp start",
    "start": "./bun dist/index.js",
    "inspector": "./bun x @modelcontextprotocol/inspector ./bun src/index.ts mcp start",
    "check": "./bun run lint && ./bun run typecheck && ./bun test",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint": "biome check",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@antfu/ni": "^28.0.0",
    "@clack/prompts": "^0.11.0",
    "@tigerdata/mcp-boilerplate": "^1.0.1",
    "commander": "^14.0.2",
    "comment-json": "^4.5.1",
    "dotenv": "^17.2.3",
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.8",
    "picocolors": "^1.1.1",
    "postgres": "^3.4.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/bun": "^1.3.5",
    "@types/node": "^24.10.7",
    "shx": "^0.4.0",
    "typescript": "^5.9.3"
  }
}
